// Single source of truth for parse_nl's 26 NUL-separated word blobs.
//
// Every literal ends with the final word's explicit NUL. As with the former
// `static const char ...[]` declarations, the C literal contributes one
// additional implicit NUL; the generator preserves that byte in the raw
// resource and reports its size in nl_tables.h.
//
// Define NL_BLOB(name, literal) before including this file. The build-time
// generator parses these same invocations to emit nl_tables.bin,
// nl_tables.h, and the host-test byte include.

NL_BLOB(NUMBER_WORDS_BLOB, "zero\0one\0two\0three\0four\0five\0six\0seven\0eight\0nine\0ten\0eleven\0twelve\0thirteen\0fourteen\0fifteen\0sixteen\0seventeen\0eighteen\0nineteen\0twenty\0thirty\0forty\0fifty\0sixty\0seventy\0eighty\0ninety\0couple\0cero\0un\0uno\0una\0dos\0tres\0cuatro\0cinco\0seis\0siete\0ocho\0nueve\0diez\0once\0doce\0trece\0catorce\0quince\0dieciseis\0diecisiete\0dieciocho\0diecinueve\0veinte\0veintiuno\0veintiuna\0veintidos\0veintitres\0veinticuatro\0veinticinco\0veintiseis\0veintisiete\0veintiocho\0veintinueve\0treinta\0cuarenta\0cincuenta\0sesenta\0setenta\0ochenta\0noventa\0")
NL_BLOB(UNIT_WORDS_BLOB, "second\0seconds\0sec\0secs\0segundo\0segundos\0seg\0segs\0minute\0minutes\0min\0mins\0minuto\0minutos\0hour\0hours\0hr\0hrs\0hora\0horas\0minutito\0minutitos\0horita\0horitas\0segundito\0segunditos\0minutillo\0minutillos\0segundillo\0segundillos\0horilla\0horillas\0minutico\0minuticos\0segundico\0segundicos\0horica\0horicas\0")
NL_BLOB(KIND_REPEAT_WORDS_BLOB, "repeat\0repeating\0every\0interval\0recurring\0repetir\0cada\0intervalo\0recurrente\0recurrentes\0repetitivo\0repetitivos\0repite\0repites\0")
NL_BLOB(KIND_STOPWATCH_WORDS_BLOB, "stopwatch\0chrono\0chronometer\0cronometro\0crono\0cronometrame\0cronometra\0")
NL_BLOB(KIND_COUNTDOWN_WORDS_BLOB, "timer\0countdown\0alarm\0temporizador\0cuenta\0atras\0alarma\0regresiva\0regresivo\0")
NL_BLOB(JOINER_WORDS_BLOB, "y\0and\0")
