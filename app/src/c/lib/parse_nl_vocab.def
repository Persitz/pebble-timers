NL_BLOB(APPROX_DROP_WORDS_BLOB, "unos\0unas\0como\0about\0around\0like\0roughly\0")
NL_BLOB(NAMEDROP_WORDS_BLOB, "please\0just\0kindly\0only\0itself\0revert\0give\0me\0need\0want\0have\0could\0would\0let\0us\0lets\0uh\0um\0hmm\0so\0okay\0ok\0maybe\0see\0well\0dale\0pone\0ponga\0poned\0echa\0echad\0quitad\0activad\0fijate\0avisame\0hazme\0hagame\0dame\0che\0parce\0parcero\0listo\0ahorita\0orita\0orale\0nomas\0sumerce\0venga\0este\0eh\0pues\0bueno\0ver\0tipo\0boludo\0ta\0bo\0posta\0pucha\0ponele\0capaz\0banda\0largo\0larga\0largos\0punto\0repente\0pico\0monedas\0")
